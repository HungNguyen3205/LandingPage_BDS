# ==============================================================================
# HỆ THỐNG TIẾP NHẬN ĐĂNG KÝ TƯ VẤN — VINHOMES LUXURY RESIDENCES
# File cấu hình mẫu môi trường (.env.example)
# Lưu ý: Tuyệt đối không lưu trữ khóa bí mật thực tế vào Git.
# ==============================================================================

# --- CHẾ ĐỘ HOẠT ĐỘNG ---
# VITE_ENABLE_DEMO_MODE=true: Ép website luôn chạy ở chế độ demo (không gửi dữ liệu đi)
# MOCK_MODE=true: Bật chế độ giả lập backend để kiểm thử tự động nội bộ
VITE_ENABLE_DEMO_MODE=true
MOCK_MODE=false

# --- CẤU HÌNH API ENDPOINT (FRONTEND) ---
# Mặc định để trống để tự động gọi endpoint nội bộ cùng domain (/api/consultation).
# Chỉ điền khi tách riêng backend sang domain/subdomain khác (ví dụ: https://api.vinhomes.vn/api/consultation).
VITE_CONSULTATION_API_URL=

# --- CẤU HÌNH GOOGLE SHEETS (BACKEND SERVER-SIDE ONLY) ---
# Phương án 1: Google Service Account (Khuyên dùng cho quy mô doanh nghiệp)
# Email tài khoản dịch vụ được cấp quyền Editor vào Google Sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Khóa riêng tư RSA Private Key (chuẩn PEM, giữ nguyên định dạng hoặc escape \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# ID bảng tính Google Sheet (nằm trên thanh URL: /spreadsheets/d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=1A2B3C4D5E6F7G8H9I0J_exampleSheetId
# Tên trang tính (Tab Sheet) chứa dữ liệu 10 cột
GOOGLE_SHEET_NAME=Đăng ký tư vấn

# Phương án 2: Google Apps Script Webhook URL (Triển khai nhanh gọn không cần Google Cloud Console)
# Điền URL Webhook sau khi deploy Webhook script trên Google Sheet
GOOGLE_SHEET_WEBHOOK_URL=

# --- CẤU HÌNH TELEGRAM BOT (BACKEND SERVER-SIDE ONLY) ---
# Token Telegram Bot do @BotFather cung cấp (ví dụ: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_placeholder
# ID nhóm chat hoặc kênh Telegram tiếp nhận thông báo (ví dụ: -1001234567890 hoặc ID người nhận)
TELEGRAM_CHAT_ID=-1001234567890
